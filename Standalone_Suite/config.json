{
  "project": {
    "name": "DIGITAL EVIDENCE FORENSIC SUITE",
    "version": "2.5.0",
    "architecture": "3-Column 25:50:25",
    "environment": "standalone"
  },
  "designTokens": {
    "colors": {
      "canvasBackground": "#0F172A",
      "surfaceGlass": "rgba(30, 41, 59, 0.65)",
      "surfaceGlassHover": "rgba(30, 41, 59, 0.85)",
      "accentSky": "#00A1E4",
      "accentSkyGlow": "#38BDF8",
      "accentGold": "#D4AF37",
      "textPrimary": "#FFFFFF",
      "textSecondary": "#94A3B8",
      "statusFailedBg": "#FDE8E8",
      "statusFailedText": "#C53030",
      "borderGlass": "rgba(255, 255, 255, 0.12)",
      "focusRing": "#38BDF8"
    },
    "typography": {
      "fontFamily": "Sarabun, sans-serif",
      "fontMono": "JetBrains Mono, monospace",
      "baseFontSize": "16px",
      "fontWeightLight": 300,
      "fontWeightNormal": 400,
      "fontWeightSemiBold": 600,
      "fontWeightBold": 700
    },
    "glassmorphism": {
      "blur": "16px",
      "shadow": "0 8px 32px 0 rgba(0, 0, 0, 0.37)"
    },
    "dimensions": {
      "canvasWidth": 645,
      "canvasHeight": 890,
      "centerTargetX": 322.5,
      "centerTargetY": 445.0,
      "watermarkOpacity": 0.10
    }
  },
  "accessibilityRules": {
    "wcagStandard": "AA",
    "enforceAriaLabels": true,
    "forceSemanticHtml": true,
    "minimumContrastRatio": 4.5,
    "highContrastFocusRings": true,
    "keyboardNavigation": true
  },
  "componentRules": {
    "zeroPrefixStripping": true,
    "prefixList": ["นาย", "นาง", "น.ส.", "นางสาว", "ด.ช.", "ด.ญ.", "ร.ต.", "ร.ท.", "ร.อ.", "พ.ต.", "พ.ท.", "พ.อ.", "ส.ต.", "ส.ท.", "ส.อ.", "จ.ส.ต.", "จ.ส.ท.", "จ.ส.อ."],
    "aspectRatioLocked": true,
    "prohibitVerticalStretching": true,
    "ledgerColumnsCount": 13,
    "failedTransactionHighlight": "#FDE8E8",
    "doubleUnderlineTotals": true,
    "disclaimerVerbatim": "ข้าพเจ้าขอรับรองว่า เอกสารชุดนี้ผ่านการถอดรหัสและรวบรวมพยานหลักฐานด้วยระบบดิจิทัลระดับพิกเซล เพื่อใช้เป็นพยานหลักฐานในกระบวนการยุติธรรม"
  },
  "dataSources": {
    "masterSlipsExcel": "Folder_Out/Evidence_Slips_Master_Unique_560.xlsx",
    "chatSlipsIndexJson": "Folder_Out/Evidence_Chat_Master_Combined_Vol1_to_3_Slip_Index.json",
    "chatInDir": "EVIDENCE_CHAT_IN/",
    "slipsInDir": "EVIDENCE_IN/",
    "outDir": "Folder_Out/"
  },
  "agentConfig": {
    "intervalMs": 2000,
    "bootGracePeriodMs": 20000,
    "maxRespawnAttempts": 5,
    "silentDaemon": true,
    "logPath": "tools/agent_heartbeat.log"
  }
}
